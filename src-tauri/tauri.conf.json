{
  "productName": "ExamOps",
  "version": "0.2.0",
  "identifier": "com.examops.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/examops-parser"],
    "resources": {
      "binaries/_internal/": "_internal/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ExamOps",
    "copyright": "Copyright (c) 2026 Yuki Wong. MIT License.",
    "category": "Education",
    "shortDescription": "基于个人学习资料的 AI 智能复习桌面软件",
    "longDescription": "导入教材、PPT、讲义和网课笔记，用自己配置的 AI 模型按章节讲解、问答、出题测验，并按掌握情况安排复习。所有数据保存在本机。",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "ExamOps",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "freezePrototype": true
    }
  }
}
